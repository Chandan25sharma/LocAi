<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Adaptive icon canvas is 108dp; keep the mark within the ~72dp safe zone so masks
         on different launchers never clip it. -->
    <item
        android:left="22dp"
        android:top="22dp"
        android:right="22dp"
        android:bottom="22dp">
        <bitmap
            android:src="@drawable/ic_locai_logo"
            android:gravity="center" />
    </item>
</layer-list>
